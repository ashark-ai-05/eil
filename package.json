{
  "name": "eil",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    }
  },
  "description": "Enterprise Intelligence Layer — knowledge plane (TypeScript)",
  "scripts": {
    "eil": "tsx ts/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ts scripts",
    "lint:fix": "biome check --write ts scripts",
    "corpus:build": "tsx scripts/build-corpus.ts",
    "corpus:check": "tsx scripts/build-corpus.ts --check",
    "pack:build": "tsx scripts/build-replay-pack.ts",
    "demo:reqs": "tsx scripts/build-demo-reqs.ts",
    "map:build": "tsx scripts/build-map.ts",
    "map:check": "tsx scripts/build-map.ts --check",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pack:smoke": "tsx scripts/pack-smoke.ts",
    "tools:check": "tsx scripts/check-tool-docs.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.0.0",
    "htmlparser2": "^10.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=2.0.5",
      "sharp": ">=0.35.0",
      "adm-zip": ">=0.6.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.0",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "bin": {
    "eil": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "models"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "license": "Apache-2.0"
}
